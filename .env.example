# Environment Variables
# Copy this file to .env and fill in values

# Database
DATABASE_URL="postgresql://cashflow_user:YOUR_DB_PASSWORD@localhost:5432/cashflow_db?pgbouncer=true"

# NextAuth
NEXTAUTH_SECRET="generate_a_random_64_char_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Security / Storage
FILE_SIGNING_SECRET="generate_a_random_64_char_secret_here"
UPLOAD_BASE_PATH="./uploads"

# SMTP (optional email notifications)
SMTP_HOST="your_smtp_host"
SMTP_PORT="587"
SMTP_USER="your_email"
SMTP_PASS="your_email_password"
SMTP_FROM="noreply@cashflow.com"
