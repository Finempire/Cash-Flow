# Environment Variables
# Copy this file to .env and fill in values

# Database
DATABASE_URL="postgresql://cashflow_user:YOUR_DB_PASSWORD@localhost:5432/cashflow_db?pgbouncer=true"

# NextAuth
NEXTAUTH_SECRET="generate_a_random_64_char_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# S3 / Cloudflare R2
S3_ACCESS_KEY="your_access_key"
S3_SECRET_KEY="your_secret_key"
S3_BUCKET_NAME="cashflow-documents"
S3_REGION="auto"
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# SMTP (optional email notifications)
SMTP_HOST="your_smtp_host"
SMTP_PORT="587"
SMTP_USER="your_email"
SMTP_PASS="your_email_password"
SMTP_FROM="noreply@cashflow.com"
