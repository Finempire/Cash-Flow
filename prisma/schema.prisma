generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── V2 Enums ───────────────────────────────────────────────────────────────

enum BlockerCode {
  WAITING_STORE_ACCEPTANCE
  WAITING_PURCHASE_REQUEST
  WAITING_RUNNER_ACCEPTANCE
  WAITING_INVOICE_UPLOAD
  WAITING_ACCOUNTANT_APPROVAL
  WAITING_PAYMENT
  WAITING_VENDOR_CONFIRMATION
  WAITING_FINAL_TAX_INVOICE
  WAITING_EXPENSE_COMPLETION
  WAITING_FINAL_SIGNOFF
}

enum NotificationType {
  ACTION_REQUIRED
  MENTION
  REMINDER
  STATUS_CHANGE
  SYSTEM
}

enum Role {
  STORE_MANAGER
  RUNNER
  ACCOUNTANT
  CEO
}

enum PurchaseStatus {
  PENDING_PURCHASE
  INVOICE_SUBMITTED
  APPROVED
  PAID
  PARTIALLY_PAID
  PAID_PENDING_TAX_INVOICE
  COMPLETED
  REJECTED
  CANCELLED
}

enum OtherExpenseStatus {
  PENDING
  PAID
  REJECTED
}

enum InvoiceType {
  PROVISIONAL
  TAX
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

enum ConfirmStatus {
  NOT_CONFIRMED
  SHOWN_TO_VENDOR
  VENDOR_CONFIRMED
}

model User {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String
  email                   String   @unique
  password_hash           String
  role                    Role
  is_active               Boolean  @default(true)
  must_change_password    Boolean  @default(true)
  notification_preference String   @default("BOTH") // INAPP | EMAIL | BOTH
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  materialRequests    MaterialRequest[]
  purchases           Purchase[]
  payments            Payment[]
  otherExpenses       OtherExpense[]       @relation("ExpenseRequester")
  expensesPaid        OtherExpense[]       @relation("ExpensePaidBy")
  vendorConfirmations VendorConfirmation[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  vendorsCreated      Vendor[]             @relation("VendorCreatedBy")
  comments            Comment[]
  remindersTriggered  Reminder[]           @relation("ReminderTriggeredBy")
  remindersTargeted   Reminder[]           @relation("ReminderTargetUser")
  drafts              DraftAutosave[]

  @@index([role])
  @@index([email])
}

enum VendorCreatedAtStage {
  MATERIAL_REQUEST
  PURCHASE
}

model Vendor {
  id                 String                @id @default(uuid()) @db.Uuid
  name               String
  gstin              String?
  contact_person     String?
  phone              String?
  address            String?
  notes              String?
  is_active          Boolean               @default(true)
  created_inline     Boolean               @default(false)
  created_at_stage   VendorCreatedAtStage?
  created_by_user_id String?               @db.Uuid
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt

  createdBy            User?                 @relation("VendorCreatedBy", fields: [created_by_user_id], references: [id])
  purchases            Purchase[]
  preferredInRequests  MaterialRequest[]

  @@index([is_active])
  @@index([created_inline])
}

model Buyer {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  brand_code      String   @unique
  contact_details String?
  notes           String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  orders           Order[]
  materialRequests MaterialRequest[]
  otherExpenses    OtherExpense[]
  styles           Style[]

  @@index([brand_code])
  @@index([is_active])
}

model Order {
  id              String    @id @default(uuid()) @db.Uuid
  order_reference String    @unique
  buyer_id        String    @db.Uuid
  style_name      String?
  season          String?
  remarks         String?
  start_date      DateTime?
  end_date        DateTime?
  shipping_date   DateTime?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  buyer            Buyer             @relation(fields: [buyer_id], references: [id])
  materialRequests MaterialRequest[]
  otherExpenses    OtherExpense[]
  styles           Style[]

  @@index([buyer_id])
  @@index([order_reference])
  @@index([is_active])
}

model Material {
  id              String   @id @default(uuid()) @db.Uuid
  sku_code        String   @unique
  description     String
  category        String?
  unit_of_measure String
  default_rate    Decimal? @db.Decimal(12, 2)
  created_inline  Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  requestLines  MaterialRequestLine[]
  purchaseLines PurchaseLine[]

  @@index([sku_code])
  @@index([category])
  @@index([created_inline])
}

model MaterialRequest {
  id                  String         @id @default(uuid()) @db.Uuid
  request_no          String         @unique
  manager_id          String         @db.Uuid
  buyer_id            String         @db.Uuid
  order_id            String         @db.Uuid
  style_id            String?        @db.Uuid
  preferred_vendor_id String?        @db.Uuid
  store_location      String?
  expected_date       DateTime?
  remarks             String?
  status              PurchaseStatus @default(PENDING_PURCHASE)
  // ── Workflow Control Fields ──────────────────────────
  pending_since_at    DateTime?
  next_action_role    Role?
  next_action_user_id String?        @db.Uuid
  next_action_label   String?
  blocker_code        BlockerCode?
  blocker_note        String?
  overdue_flag        Boolean        @default(false)
  overdue_reason      String?
  last_activity_at    DateTime?
  // ── SLA Tracking ────────────────────────────────────
  entered_stage_at    DateTime?
  exited_stage_at     DateTime?
  stage_duration_hours Float?
  sla_due_at          DateTime?
  sla_breached        Boolean        @default(false)
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  manager          User    @relation(fields: [manager_id], references: [id])
  buyer            Buyer   @relation(fields: [buyer_id], references: [id])
  order            Order   @relation(fields: [order_id], references: [id])
  style            Style?  @relation(fields: [style_id], references: [id])
  preferred_vendor Vendor? @relation(fields: [preferred_vendor_id], references: [id])

  lines     MaterialRequestLine[]
  purchases Purchase[]

  @@index([status])
  @@index([manager_id])
  @@index([buyer_id])
  @@index([order_id])
  @@index([style_id])
  @@index([preferred_vendor_id])
  @@index([created_at])
  @@index([overdue_flag])
  @@index([blocker_code])
}

model MaterialRequestLine {
  id              String   @id @default(uuid()) @db.Uuid
  request_id      String   @db.Uuid
  material_id     String   @db.Uuid
  description     String?
  quantity        Decimal  @db.Decimal(12, 2)
  expected_rate   Decimal  @db.Decimal(12, 2)
  expected_amount Decimal  @db.Decimal(12, 2)
  created_at      DateTime @default(now())

  request  MaterialRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  material Material        @relation(fields: [material_id], references: [id])

  @@index([request_id])
  @@index([material_id])
}

model Purchase {
  id                       String         @id @default(uuid()) @db.Uuid
  purchase_no              String         @unique
  request_id               String         @db.Uuid
  runner_id                String         @db.Uuid
  vendor_id                String         @db.Uuid
  invoice_no               String
  invoice_date             DateTime
  invoice_amount           Decimal        @db.Decimal(12, 2)
  invoice_type_submitted   InvoiceType
  provisional_invoice_path String?
  tax_invoice_path         String?
  accountant_notes         String?
  reopen_reason            String?
  status                   PurchaseStatus @default(INVOICE_SUBMITTED)
  // ── Workflow Control Fields ──────────────────────────
  pending_since_at         DateTime?
  next_action_role         Role?
  next_action_user_id      String?        @db.Uuid
  next_action_label        String?
  blocker_code             BlockerCode?
  blocker_note             String?
  overdue_flag             Boolean        @default(false)
  overdue_reason           String?
  last_activity_at         DateTime?
  // ── SLA Tracking ────────────────────────────────────
  entered_stage_at         DateTime?
  exited_stage_at          DateTime?
  stage_duration_hours     Float?
  sla_due_at               DateTime?
  sla_breached             Boolean        @default(false)
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt

  request            MaterialRequest      @relation(fields: [request_id], references: [id])
  runner             User                 @relation(fields: [runner_id], references: [id])
  vendor             Vendor               @relation(fields: [vendor_id], references: [id])
  lines              PurchaseLine[]
  payments           Payment[]
  vendorConfirmation VendorConfirmation?

  @@index([status])
  @@index([runner_id])
  @@index([vendor_id])
  @@index([request_id])
  @@index([created_at])
  @@index([overdue_flag])
  @@index([blocker_code])
  @@index([invoice_no])
}

model PurchaseLine {
  id          String  @id @default(uuid()) @db.Uuid
  purchase_id String  @db.Uuid
  material_id String  @db.Uuid
  quantity    Decimal @db.Decimal(12, 2)
  rate        Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  material Material @relation(fields: [material_id], references: [id])

  @@index([purchase_id])
  @@index([material_id])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  purchase_id    String        @db.Uuid
  accountant_id  String        @db.Uuid
  payment_date   DateTime
  payment_method PaymentMethod
  amount_paid    Decimal       @db.Decimal(12, 2)
  reference_id   String?
  payment_proof_path String
  notes          String?
  created_at     DateTime      @default(now())

  purchase  Purchase @relation(fields: [purchase_id], references: [id])
  accountant User    @relation(fields: [accountant_id], references: [id])

  @@index([purchase_id])
  @@index([accountant_id])
  @@index([created_at])
}

model VendorConfirmation {
  id                  String        @id @default(uuid()) @db.Uuid
  purchase_id         String        @unique @db.Uuid
  runner_id           String        @db.Uuid
  status              ConfirmStatus @default(NOT_CONFIRMED)
  shown_to_vendor_at  DateTime?
  vendor_confirmed_at DateTime?
  runner_remark       String?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  purchase Purchase @relation(fields: [purchase_id], references: [id])
  runner   User     @relation(fields: [runner_id], references: [id])

  @@index([runner_id])
  @@index([status])
}

model Notification {
  id                String           @id @default(uuid()) @db.Uuid
  user_id           String           @db.Uuid
  title             String
  message           String
  entity_type       String
  entity_id         String           @db.Uuid
  notification_type NotificationType @default(ACTION_REQUIRED)
  action_url        String?
  is_read           Boolean          @default(false)
  is_email_sent     Boolean          @default(false)
  created_at        DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([is_read])
  @@index([notification_type])
  @@index([created_at])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  entity_type    String
  entity_id      String   @db.Uuid
  action         String
  performed_by   String   @db.Uuid
  previous_state Json?
  new_state      Json?
  ip_address     String?
  created_at     DateTime @default(now())

  performer User @relation(fields: [performed_by], references: [id])

  @@index([entity_type, entity_id])
  @@index([performed_by])
  @@index([created_at])
}

model OtherExpense {
  id                   String             @id @default(uuid()) @db.Uuid
  expense_no           String             @unique
  user_id              String             @db.Uuid
  buyer_id             String?            @db.Uuid
  order_id             String?            @db.Uuid
  style_id             String?            @db.Uuid
  category             String?
  description          String
  amount               Decimal            @db.Decimal(12, 2)
  invoice_path         String?
  payment_details      String
  status               OtherExpenseStatus @default(PENDING)
  payment_proof_path   String?
  accountant_notes     String?
  reopen_reason        String?
  accountant_id        String?            @db.Uuid
  // ── Workflow Control Fields ──────────────────────────
  pending_since_at     DateTime?
  next_action_role     Role?
  next_action_user_id  String?            @db.Uuid
  next_action_label    String?
  blocker_code         BlockerCode?
  blocker_note         String?
  overdue_flag         Boolean            @default(false)
  overdue_reason       String?
  last_activity_at     DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  requester  User    @relation("ExpenseRequester", fields: [user_id], references: [id])
  accountant User?   @relation("ExpensePaidBy", fields: [accountant_id], references: [id])
  buyer      Buyer?  @relation(fields: [buyer_id], references: [id])
  order      Order?  @relation(fields: [order_id], references: [id])
  style      Style?  @relation(fields: [style_id], references: [id])

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@index([buyer_id])
  @@index([order_id])
  @@index([overdue_flag])
  @@index([blocker_code])
}

// ─── V2 New Models ───────────────────────────────────────────────────────────

model Style {
  id             String   @id @default(uuid()) @db.Uuid
  style_code     String   @unique
  style_name     String
  buyer_id       String?  @db.Uuid
  order_id       String?  @db.Uuid
  description    String?
  is_active      Boolean  @default(true)
  created_inline Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  buyer            Buyer?            @relation(fields: [buyer_id], references: [id])
  order            Order?            @relation(fields: [order_id], references: [id])
  materialRequests MaterialRequest[]
  otherExpenses    OtherExpense[]

  @@index([buyer_id])
  @@index([order_id])
  @@index([is_active])
  @@index([style_code])
}

// Polymorphic comment: entity_type + entity_id identify the parent record.
// Prisma does not support multi-table FK for polymorphic relations;
// queries are done in the API layer using entity_type + entity_id.
model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  entity_type String   // 'Order' | 'MaterialRequest' | 'Purchase' | 'OtherExpense'
  entity_id   String   // UUID stored as string — no FK constraint (polymorphic)
  author_id   String   @db.Uuid
  body        String
  mentions    String[] // user IDs mentioned
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  author User @relation(fields: [author_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([author_id])
  @@index([created_at])
}

// Polymorphic reminder: same pattern as Comment — no direct FK.
model Reminder {
  id              String    @id @default(uuid()) @db.Uuid
  entity_type     String    // 'MaterialRequest' | 'Purchase' | 'OtherExpense'
  entity_id       String    // UUID stored as string — no FK constraint (polymorphic)
  triggered_by_id String    @db.Uuid
  target_role     Role?
  target_user_id  String?   @db.Uuid
  message         String
  is_sent         Boolean   @default(false)
  sent_at         DateTime?
  created_at      DateTime  @default(now())

  triggeredBy User  @relation("ReminderTriggeredBy", fields: [triggered_by_id], references: [id])
  targetUser  User? @relation("ReminderTargetUser", fields: [target_user_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([is_sent])
  @@index([created_at])
}

model DraftAutosave {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  entity_type String   // 'MaterialRequest' | 'OtherExpense' | 'Purchase'
  draft_key   String   // unique key per form session
  data        Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, entity_type, draft_key])
  @@index([user_id])
  @@index([entity_type])
}
